}

// ShowResetPassword handles GET /reset-password.
//
// The token is checked before the form is drawn, so a stale link says so
// straight away rather than after somebody has chosen and typed a new password
// twice.
func (c *Auth) ShowResetPassword(w http.ResponseWriter, r *http.Request) {
	token := r.URL.Query().Get("token")
	if err := c.CheckResetToken(token); err != nil {
		c.expiredResetLink(w, r)
		return
	}

	c.Render(w, r, auth.ResetPassword(auth.ResetPasswordForm{Token: token}))
}

// ResetPassword handles POST /reset-password.
func (c *Auth) ResetPassword(w http.ResponseWriter, r *http.Request) {
	var form requests.ResetPassword

	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}
	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.ResetPassword(auth.ResetPasswordForm{
			Token: form.Token, Errors: bag,
		}))
		return
	}

	_, err = c.authCore.ResetPassword(r, form)
	switch {
	case errors.Is(err, errInvalidLink):
		c.expiredResetLink(w, r)
		return
	case err != nil:
		c.serverError(w, r, "store the new password", err)
		return
	}

	c.App.Flash.Add(w, r, flash.Success, "Your password has been changed. Sign in with it.")
	c.Redirect(w, r, "/login")
}

func (c *Auth) serverError(w http.ResponseWriter, r *http.Request, what string, err error) {
	c.App.Log.Error("could not "+what, "error", err, "path", r.URL.Path)
	http.Error(w, "Something went wrong.", http.StatusInternalServerError)
}

// expiredResetLink sends the visitor back to ask for a fresh link.
func (c *Auth) expiredResetLink(w http.ResponseWriter, r *http.Request) {
	c.App.Flash.Add(w, r, flash.Error,
		"That reset link is invalid or has expired. Ask for a new one.")
	c.Redirect(w, r, "/forgot-password")
}
