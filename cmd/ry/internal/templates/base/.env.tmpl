# Application
APP_NAME={{.Name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_ADDR=:8080

# Signs cookies: CSRF tokens, flash messages, sessions. Generated for this
# project. Keep it out of version control and use a different one per
# environment; rotating it invalidates every signed cookie.
APP_KEY={{.AppKey}}

# Database
DB_DRIVER={{.DB}}
DB_DSN={{.DefaultDSN}}
DB_LOG_QUERIES=false

# Logging
# LOG_LEVEL:  debug | info | warn | error
# LOG_FORMAT: auto | console | text | json
#   auto is a compact colour console on a terminal, JSON when redirected.
LOG_LEVEL=info
LOG_FORMAT=auto
