:root {
	color-scheme: light dark;
	--bg: #ffffff;
	--fg: #1a1a1a;
	--muted: #666f7a;
	--accent: #2f6feb;
	--code-bg: #f2f4f7;
	--border: #e3e6ea;
}

@media (prefers-color-scheme: dark) {
	:root {
		--bg: #14171a;
		--fg: #e8eaed;
		--muted: #9aa4ae;
		--accent: #6ea0ff;
		--code-bg: #1e2429;
		--border: #2b3238;
	}
}

* {
	box-sizing: border-box;
}

body {
	margin: 0;
	background: var(--bg);
	color: var(--fg);
	font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

.container {
	max-width: 42rem;
	margin: 0 auto;
	padding: 4rem 1.5rem;
}

h1 {
	margin: 0 0 0.5rem;
	font-size: 2rem;
	letter-spacing: -0.02em;
}

.lead {
	margin: 0 0 2rem;
	color: var(--muted);
}

.next {
	margin: 0;
	padding: 0;
	list-style: none;
	border-top: 1px solid var(--border);
}

.next li {
	padding: 0.75rem 0;
	border-bottom: 1px solid var(--border);
	color: var(--muted);
}

code {
	padding: 0.15em 0.4em;
	border-radius: 4px;
	background: var(--code-bg);
	color: var(--fg);
	font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
	font-size: 0.9em;
}

a {
	color: var(--accent);
}
