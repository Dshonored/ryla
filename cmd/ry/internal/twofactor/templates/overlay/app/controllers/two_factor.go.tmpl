// TwoFactor handles enrolling in, clearing and turning off TOTP two-factor
// authentication.
type TwoFactor struct {
	Base

	// vault seals secrets before they reach the database, and opens them again
	// to check a code.
	vault *twofactor.Vault

	// verifier is what actually checks codes. It carries the throttle, which is
	// why every path below goes through it instead of calling twofactor.Verify:
	// six digits is a million guesses, and a million guesses is an afternoon.
	verifier *twofactor.Verifier

	opts twofactor.Options
}

// NewTwoFactor builds the controller.
//
// It refuses to start without APP_KEY, at boot rather than at the first
// request. Secrets are sealed with that key, and sealing them with nothing is
// the same as storing them in plaintext — which would leave the second factor
// defending against everybody except the attacker who has the database, the one
// it was added for.
func NewTwoFactor(a *app.App) *TwoFactor {
	opts := twofactor.Options{Issuer: a.Config.Name}

	vault, err := twofactor.NewVault(a.Config.Key)
	if err != nil {
		panic("two-factor authentication cannot start: " + err.Error() +
			". Generate a key with: ry key:generate")
	}

	return &TwoFactor{
		Base:     Base{App: a},
		vault:    vault,
		verifier: twofactor.NewVerifier(opts),
		opts:     opts,
	}
}

// ShowSetup handles GET /two-factor/setup.
func (c *TwoFactor) ShowSetup(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}

	form := auth.TwoFactorSetupForm{
		Enabled:  user.TwoFactorEnabled,
		Messages: c.App.Flash.Pull(w, r),
	}

	if user.TwoFactorEnabled {
		form.RecoveryCodesLeft = twofactor.CountRecoveryCodes(user.TwoFactorRecoveryCodes)
		c.Render(w, r, auth.TwoFactorSetup(form))
		return
	}

	secret, err := c.pendingSecret(r, user)
	if err != nil {
		c.twoFactorError(w, r, "start an enrolment", err)
		return
	}

	// The secret is shown as text as well as in the QR code: a desktop password
	// manager, or a phone with a broken camera, needs to be able to type it.
	form.Secret = secret
	c.Render(w, r, auth.TwoFactorSetup(form))
}

// SetupQRCode handles GET /two-factor/setup/qr.png.
//
// The QR code is served from its own URL rather than inlined into the page as a
// data: URI. Inlined, the secret would sit in the browser's history, in the
// rendered HTML of any page cache that saw it, and in the "view source" of a
// screen someone else might be looking at.
func (c *TwoFactor) SetupQRCode(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		http.NotFound(w, r)
		return
	}

	secret, err := c.pendingSecret(r, user)
	if err != nil {
		c.twoFactorError(w, r, "render the QR code", err)
		return
	}

	uri, err := twofactor.URI(user.Email, secret, c.opts)
	if err != nil {
		c.twoFactorError(w, r, "build the enrolment URI", err)
		return
	}

	png, err := twofactor.QRCodePNG(uri, 240)
	if err != nil {
		c.twoFactorError(w, r, "render the QR code", err)
		return
	}

	// This image is the secret. Nothing between here and the browser should
	// keep a copy of it.
	w.Header().Set("Cache-Control", "no-store, private")
	w.Header().Set("Content-Type", "image/png")
	if _, err := w.Write(png); err != nil {
		c.App.Log.Error("could not write the QR code", "error", err)
	}
}

// Enable handles POST /two-factor/setup.
//
// Nothing is written to the account until a code from the user's own app has
// been checked. Enrolling first and confirming later would let a mis-scanned QR
// code lock somebody out of their own account on the next sign-in.
func (c *TwoFactor) Enable(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}
	if user.TwoFactorEnabled {
		c.App.Flash.Add(w, r, flash.Info, "Two-factor authentication is already on for this account.")
		c.Redirect(w, r, "/two-factor/setup")
		return
	}

	var form requests.TwoFactorCode
	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}

	secret, secretErr := c.pendingSecret(r, user)
	if secretErr != nil {
		c.twoFactorError(w, r, "read the enrolment in progress", secretErr)
		return
	}

	if !bag.Any() {
		accepted, retryAfter := c.verifier.Verify(c.subject(user), secret, form.Code)
		switch {
		case retryAfter > 0:
			c.throttled(w, r, retryAfter, auth.TwoFactorSetup(auth.TwoFactorSetupForm{
				Secret: secret,
				Errors: throttleBag(retryAfter),
			}))
			return
		case !accepted:
			bag.Add("code", "That code is not right. Check your app and try the current one.")
		}
	}

	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.TwoFactorSetup(auth.TwoFactorSetupForm{
			Secret: secret, Errors: bag,
		}))
		return
	}

	codes, err := twofactor.GenerateRecoveryCodes(twofactor.DefaultRecoveryCodes)
	if err != nil {
		c.twoFactorError(w, r, "generate recovery codes", err)
		return
	}

	sealed, err := c.vault.Seal(secret)
	if err != nil {
		c.twoFactorError(w, r, "seal the secret", err)
		return
	}

	// One statement, so an account can never be left with the flag set and no
	// secret behind it — which would lock the user out of their own account
	// with no code that could ever open it.
	err = c.App.DB.WithContext(r.Context()).Model(user).Updates(map[string]any{
		"two_factor_secret":         sealed,
		"two_factor_enabled":        true,
		"two_factor_recovery_codes": twofactor.HashRecoveryCodes(codes),
	}).Error
	if err != nil {
		c.twoFactorError(w, r, "turn on two-factor authentication", err)
		return
	}

	// They have just proved they hold the second factor, so this session has
	// cleared the challenge. Without it the middleware would bounce them
	// straight back here.
	twofactor.MarkPassed(session.From(r.Context()))

	// Rendered rather than redirected: the codes exist only in memory, and a
	// redirect would lose them. This is the one and only time they are readable
	// — everything stored is a hash.
	c.Render(w, r, auth.TwoFactorRecoveryCodes(auth.TwoFactorRecoveryCodesForm{Codes: codes}))
}

// ShowChallenge handles GET /two-factor.
func (c *TwoFactor) ShowChallenge(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}
	if !user.TwoFactorEnabled || twofactor.Passed(session.From(r.Context())) {
		c.Redirect(w, r, "/")
		return
	}

	c.Render(w, r, auth.TwoFactorChallenge(auth.TwoFactorChallengeForm{
		RecoveryCodesLeft: twofactor.CountRecoveryCodes(user.TwoFactorRecoveryCodes),
		Messages:          c.App.Flash.Pull(w, r),
	}))
}

// Challenge handles POST /two-factor.
func (c *TwoFactor) Challenge(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}

	var form requests.TwoFactorCode
	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}

	secret, secretErr := c.storedSecret(user)
	if secretErr != nil {
		c.twoFactorError(w, r, "read the stored secret", secretErr)
		return
	}

	if !bag.Any() {
		accepted, retryAfter := c.verifier.Verify(c.subject(user), secret, form.Code)
		switch {
		case retryAfter > 0:
			c.throttled(w, r, retryAfter, auth.TwoFactorChallenge(auth.TwoFactorChallengeForm{
				Errors: throttleBag(retryAfter),
			}))
			return
		case accepted:
			c.pass(w, r)
			return
		}
		bag.Add("code", "That code is not right. Wait for the next one and try again.")
	}

	c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.TwoFactorChallenge(auth.TwoFactorChallengeForm{
		RecoveryCodesLeft: twofactor.CountRecoveryCodes(user.TwoFactorRecoveryCodes),
		Errors:            bag,
	}))
}

// Recover handles POST /two-factor/recovery.
//
// This is the door for a lost phone, and it is the reason recovery codes exist
// at all: without them, a dropped handset is a closed account and the only way
// back in is a support ticket that has to be answered by trusting somebody's
// email address, which is exactly the trust two-factor authentication was
// meant to stop relying on.
func (c *TwoFactor) Recover(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}

	var form requests.TwoFactorRecovery
	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}

	if !bag.Any() {
		remaining, accepted, retryAfter := c.verifier.VerifyRecovery(
			c.subject(user), user.TwoFactorRecoveryCodes, form.RecoveryCode)

		switch {
		case retryAfter > 0:
			c.throttled(w, r, retryAfter, auth.TwoFactorChallenge(auth.TwoFactorChallengeForm{
				Errors: throttleBag(retryAfter),
			}))
			return

		case accepted:
			// Spent before the session is let through. A code that signed
			// somebody in and then failed to save would still be usable, which
			// is the one thing a recovery code must never be.
			err := c.App.DB.WithContext(r.Context()).Model(user).
				Update("two_factor_recovery_codes", remaining).Error
			if err != nil {
				c.twoFactorError(w, r, "spend the recovery code", err)
				return
			}

			left := twofactor.CountRecoveryCodes(remaining)
			c.App.Flash.Add(w, r, flash.Warning, "Recovery code used. You have "+
				strconv.Itoa(left)+" left — turn two-factor authentication off and on again to get a fresh set.")
			c.pass(w, r)
			return
		}

		bag.Add("recovery_code", "That recovery code is not one of yours, or it has already been used.")
	}

	c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.TwoFactorChallenge(auth.TwoFactorChallengeForm{
		RecoveryCodesLeft: twofactor.CountRecoveryCodes(user.TwoFactorRecoveryCodes),
		Errors:            bag,
	}))
}

// Disable handles POST /two-factor/disable.
//
// A current code is required. Without one, anybody who found an unlocked laptop
// could take the second factor off in a single click, which would make it a
// speed bump rather than a defence.
func (c *TwoFactor) Disable(w http.ResponseWriter, r *http.Request) {
	user, ok := c.user(r)
	if !ok {
		c.Redirect(w, r, "/login")
		return
	}
	if !user.TwoFactorEnabled {
		c.Redirect(w, r, "/two-factor/setup")
		return
	}

	var form requests.TwoFactorCode
	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}

	secret, secretErr := c.storedSecret(user)
	if secretErr != nil {
		c.twoFactorError(w, r, "read the stored secret", secretErr)
		return
	}

	if !bag.Any() {
		accepted, retryAfter := c.verifier.Verify(c.subject(user), secret, form.Code)
		switch {
		case retryAfter > 0:
			bag = throttleBag(retryAfter)
		case !accepted:
			bag.Add("code", "That code is not right, so nothing has been changed.")
		}
	}

	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.TwoFactorSetup(auth.TwoFactorSetupForm{
			Enabled:           true,
			RecoveryCodesLeft: twofactor.CountRecoveryCodes(user.TwoFactorRecoveryCodes),
			Errors:            bag,
		}))
		return
	}

	// The recovery codes go with the secret. Leaving them behind would keep a
	// set of working single-factor passwords on an account that no longer has a
	// second factor to protect.
	err = c.App.DB.WithContext(r.Context()).Model(user).Updates(map[string]any{
		"two_factor_secret":         "",
		"two_factor_enabled":        false,
		"two_factor_recovery_codes": "",
	}).Error
	if err != nil {
		c.twoFactorError(w, r, "turn off two-factor authentication", err)
		return
	}

	c.App.Flash.Add(w, r, flash.Info, "Two-factor authentication is off.")
	c.Redirect(w, r, "/two-factor/setup")
}

// pass marks the session as having cleared the challenge and sends the user on
// to wherever they were originally heading.
func (c *TwoFactor) pass(w http.ResponseWriter, r *http.Request) {
	s := session.From(r.Context())
	twofactor.MarkPassed(s)
	c.Redirect(w, r, ryauth.Intended(s, "/"))
}

// user loads the signed-in account.
//
// It reads the database rather than the request context so that the controller
// works whichever order the route files were registered in. The two-factor
// pages are a handful of requests per sign-in, so the extra query is not worth
// a subtle ordering dependency.
func (c *TwoFactor) user(r *http.Request) (*models.User, bool) {
	id, ok := ryauth.UintID(session.From(r.Context()))
	if !ok {
		return nil, false
	}

	var user models.User
	if err := c.App.DB.WithContext(r.Context()).First(&user, id).Error; err != nil {
		return nil, false
	}
	return &user, true
}

// pendingSecret returns the plaintext secret for the enrolment in progress,
// starting one if there is none.
//
// The secret waits in the session, sealed, rather than in the users table: an
// abandoned enrolment then leaves nothing behind, and a half-scanned secret can
// never be mistaken for a live one. It is sealed even there because the cookie
// session store signs its contents but does not encrypt them.
//
// The same secret is returned on every call until it is confirmed. Generating a
// fresh one per page view would silently invalidate the QR code the moment
// somebody refreshed.
func (c *TwoFactor) pendingSecret(r *http.Request, user *models.User) (string, error) {
	s := session.From(r.Context())

	if sealed := twofactor.PendingSecret(s); sealed != "" {
		return c.vault.Open(sealed)
	}

	fresh, err := twofactor.NewSecret(user.Email, c.opts)
	if err != nil {
		return "", err
	}
	sealed, err := c.vault.Seal(fresh.Base32)
	if err != nil {
		return "", err
	}

	twofactor.PutPendingSecret(s, sealed)
	return fresh.Base32, nil
}

// storedSecret opens the secret held against the account.
func (c *TwoFactor) storedSecret(user *models.User) (string, error) {
	return c.vault.Open(user.TwoFactorSecret)
}

// subject is what the throttle counts against: the account, not the address
// typed into a form, so that respelling an email cannot buy a fresh budget.
func (c *TwoFactor) subject(user *models.User) string {
	return "2fa:" + strconv.FormatUint(uint64(user.ID), 10)
}

// throttled renders a rejection with the header a client needs to back off
// politely.
func (c *TwoFactor) throttled(w http.ResponseWriter, r *http.Request, retryAfter time.Duration, page templ.Component) {
	w.Header().Set("Retry-After", strconv.Itoa(int(retryAfter.Seconds())+1))
	c.App.Log.Warn("two-factor verification throttled", "path", r.URL.Path, "retry_after", retryAfter)
	c.RenderStatus(w, r, http.StatusTooManyRequests, page)
}

// throttleBag says how long to wait rather than just refusing. "Wrong code" and
// "out of attempts" are different problems and lead to different next steps.
func throttleBag(retryAfter time.Duration) validate.ErrorBag {
	bag := validate.ErrorBag{}
	minutes := int(retryAfter.Minutes()) + 1
	bag.Add("code", "Too many attempts. Try again in about "+strconv.Itoa(minutes)+" minutes, or use a recovery code.")
	return bag
}

// twoFactorError logs the detail and shows the user nothing useful to an
// attacker probing for the difference between a wrong key and a wrong code.
func (c *TwoFactor) twoFactorError(w http.ResponseWriter, r *http.Request, what string, err error) {
	c.App.Log.Error("could not "+what, "error", err, "path", r.URL.Path)
	http.Error(w, "Something went wrong.", http.StatusInternalServerError)
}
