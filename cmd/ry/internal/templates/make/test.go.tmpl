package tests

import (
	"net/url"
	"testing"
)

// Test{{.Pascal}}Index checks that the listing page renders.
//
// client comes from example_test.go: a browser-like client on the application's
// real router, with its own cookies and the CSRF token already attached to
// every unsafe request.
func Test{{.Pascal}}Index(t *testing.T) {
	client(t).Get("/{{.KebabPlural}}").
		AssertOK().
		AssertContains("{{.Plural}}")
}

// Test{{.Pascal}}Store covers the submit path: what a browser actually posts,
// and where the handler sends it afterwards.
func Test{{.Pascal}}Store(t *testing.T) {
	c := client(t)
	// Where the route needs a signed-in user, start from one:
	//	c.LoginID(1)

	c.Post("/{{.KebabPlural}}", url.Values{
		"name": {"Example"},
	}).AssertRedirect("/{{.KebabPlural}}")
}
