<script lang="ts">
	import { onMount } from "svelte";

	import { ApiError, get, post, type Fields } from "./api";

	// The welcome page.
	//
	// It exists to be deleted, and it is written to be worth reading first:
	// every panel below is a real round trip to the Go server, so a page that
	// renders is proof that the API, the router, the proxy and the build all
	// agree.
	//
	// To remove it: replace this file, then delete app/controllers/demo.go,
	// app/requests/subscribe.go and the /api/demo routes in routes/web.go.

	// What the endpoints on this page return. They live here rather than in
	// api.ts because they describe this application, and the API client has no
	// business knowing the shape of any particular route. They mirror the Go
	// structs in app/controllers, which are the real source of truth.
	interface Endpoint {
		name: string;
		method: string;
		path: string;
	}

	interface ServiceInfo {
		name: string;
		environment: string;
		ryla: string;
		go: string;
		database: string;
		endpoints: Endpoint[];
	}

	interface Counter {
		count: number;
	}

	interface Subscriber {
		name: string;
	}

	// message pulls something printable out of an unknown thrown value. A catch
	// binding is `unknown` under strict TypeScript, and assuming it is an Error
	// is how you get "undefined" on screen when something throws a string.
	function errorText(err: unknown): string {
		return err instanceof Error ? err.message : String(err);
	}

	let service = $state<ServiceInfo | null>(null);
	let failure = $state("");

	// The counter is held by the server, so it survives a reload of this page
	// and resets only when the process does.
	let count = $state<number | null>(null);
	let counterBusy = $state(false);
	let counterFailure = $state("");

	let form = $state({ name: "", email: "" });
	let errors = $state<Fields>({});
	let message = $state("");
	let formBusy = $state(false);

	onMount(async () => {
		try {
			service = await get<ServiceInfo>("/api");
		} catch (err: unknown) {
			failure = errorText(err);
		}
		await counter(() => get<Counter>("/api/demo/counter"));
	});

	async function counter(request: () => Promise<Counter>) {
		counterBusy = true;
		counterFailure = "";
		try {
			const body = await request();
			count = body.count;
		} catch (err: unknown) {
			counterFailure = errorText(err);
		} finally {
			counterBusy = false;
		}
	}

	// The shape almost every form takes: send it, and either show the messages
	// the server rejected it with — keyed by the field name it was sent under,
	// so each one lands beside its own input — or report the success.
	async function subscribe(event: SubmitEvent) {
		event.preventDefault();
		formBusy = true;
		errors = {};
		message = "";

		try {
			const created = await post<Subscriber>("/api/demo/subscribe", form);
			message = `Thanks, ${created.name} — that submission validated cleanly.`;
			form = { name: "", email: "" };
		} catch (err: unknown) {
			if (err instanceof ApiError && err.status === 422) {
				errors = err.fields;
			} else {
				message = errorText(err);
			}
		} finally {
			formBusy = false;
		}
	}
</script>

<main class="container">
	<header class="stack">
		<span class="badge">Ryla</span>
		<h1>{service ? service.name : "Loading..."}</h1>
		<p class="muted">
			A Go server and a Svelte frontend, served from one address and shipped
			as one binary.
		</p>
	</header>

	{#if failure}
		<p class="notice error">
			Could not reach the API: {failure}. Is the server still running?
		</p>
	{/if}

	<section class="grid">
		<article class="card">
			<h2>This application</h2>
			{#if service}
				<dl class="facts">
					<dt>Environment</dt>
					<dd>{service.environment}</dd>
					<dt>Ryla</dt>
					<dd>{service.ryla}</dd>
					<dt>Go</dt>
					<dd>{service.go}</dd>
					<dt>Database</dt>
					<dd>{service.database}</dd>
				</dl>
			{:else}
				<p class="subtle">Waiting for GET /api...</p>
			{/if}
		</article>

		<article class="card">
			<h2>Counter</h2>
			<p class="counter">{count === null ? "—" : count}</p>
			<div class="row">
				<button
					disabled={counterBusy}
					onclick={() => counter(() => post<Counter>("/api/demo/counter"))}
				>
					Increment
				</button>
				<button
					class="secondary"
					disabled={counterBusy}
					onclick={() => counter(() => post<Counter>("/api/demo/counter/reset"))}
				>
					Reset
				</button>
			</div>
			{#if counterFailure}
				<p class="notice error">{counterFailure}</p>
			{/if}
			<p class="subtle">Held in memory by app/controllers/demo.go.</p>
		</article>
	</section>

	<section class="card">
		<h2>Validation</h2>
		<p class="muted">
			The rules live in app/requests/subscribe.go. Submit it empty to see what
			a 422 looks like.
		</p>

		<form class="stack" onsubmit={subscribe} novalidate>
			<label>
				Name
				<input bind:value={form.name} />
				{#if errors.name}
					<span class="field-error">{errors.name.join(" ")}</span>
				{/if}
			</label>
			<label>
				Email
				<input bind:value={form.email} />
				{#if errors.email}
					<span class="field-error">{errors.email.join(" ")}</span>
				{/if}
			</label>
			<div class="row">
				<button disabled={formBusy}>Subscribe</button>
			</div>
		</form>

		{#if message}
			<p class="notice success">{message}</p>
		{/if}
	</section>

	<!-- The endpoint list comes from the router itself, so it cannot drift away
	     from routes/web.go. -->
	{#if service && service.endpoints.length}
		<section class="card">
			<h2>Endpoints</h2>
			<table class="endpoints">
				<thead>
					<tr>
						<th>Name</th>
						<th>Method</th>
						<th>Path</th>
					</tr>
				</thead>
				<tbody>
					{#each service.endpoints as endpoint (endpoint.name + endpoint.method)}
						<tr>
							<td>{endpoint.name}</td>
							<td>{endpoint.method}</td>
							<td>{endpoint.path}</td>
						</tr>
					{/each}
				</tbody>
			</table>
		</section>
	{/if}

	<section class="card">
		<h2>Where things are</h2>
		<dl class="facts">
			<dt>resources/frontend/src</dt>
			<dd>this page</dd>
			<dt>routes/web.go</dt>
			<dd>the route table</dd>
			<dt>app/controllers</dt>
			<dd>the JSON endpoints</dd>
			<dt>app/models</dt>
			<dd>the database types</dd>
		</dl>
		<p class="subtle">
			Save a file under src/ and the browser updates without reloading; save a
			.go file and <code>ry dev</code> rebuilds and reloads it for you.
		</p>
	</section>
</main>
