package middleware

import (
	"context"
	"net/http"
	"strings"

	"{{.RylaModule}}/auth"
	"{{.RylaModule}}/session"
	"{{.RylaModule}}/twofactor"
)

// Exempt paths, or the challenge could never be answered. /logout too, because
// somebody who cannot complete the challenge must still be able to end the
// session rather than being trapped in it. And the static assets, so the
// challenge page has its stylesheet.
var twoFactorExempt = []string{
	"/two-factor",
	"/api/two-factor",
	"/logout",
	"/api/auth/logout",
	"/static",
}

// TwoFactorLookup answers whether an account has a second factor enabled.
//
// A function rather than a database handle: the query differs completely
// between a SQL project and a document store, and the rule below — which is the
// part worth getting right — does not. models supplies the implementation.
type TwoFactorLookup func(ctx context.Context, userID string) (bool, error)

// RequireTwoFactor holds a signed-in session at the challenge until it has
// been cleared.
//
// The check lives in middleware rather than in the sign-in handler on purpose.
// A sign-in handler that redirected to the challenge would protect the one
// route it runs on; everything else — an API call, a page opened from a
// bookmark, a form posted from another tab — would still see an authenticated
// session and let it through. Putting it here means a route added a year from
// now is covered without anybody remembering to cover it.
//
// It is deliberately not the same thing as being signed out. The session does
// identify a user, and the password has already been checked; what is missing
// is the second factor, and that is all this withholds. unmet is what says so —
// a redirect for a browser, a 403 for a client that parses its responses.
func RequireTwoFactor(enabled TwoFactorLookup, unmet http.Handler) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			s := session.From(r.Context())

			id := auth.ID(s)
			if id == "" || twofactor.Passed(s) || exemptFromTwoFactor(r.URL.Path) {
				next.ServeHTTP(w, r)
				return
			}

			on, err := enabled(r.Context(), id)
			switch {
			case err != nil:
				// Failing open would turn a database blip into a way past the
				// second factor, so this fails closed.
				http.Error(w, "Something went wrong.", http.StatusInternalServerError)
				return
			case !on:
				next.ServeHTTP(w, r)
				return
			}

			// Remembered so the challenge can send them where they were going,
			// rather than dumping everyone on the home page.
			if r.Method == http.MethodGet {
				s.Put(auth.IntendedKey, r.URL.RequestURI())
			}

			unmet.ServeHTTP(w, r)
		})
	}
}

// exemptFromTwoFactor matches on a path segment boundary, so that a route named
// /two-factor-something-else is not accidentally waved through.
func exemptFromTwoFactor(path string) bool {
	for _, prefix := range twoFactorExempt {
		if path == prefix || strings.HasPrefix(path, prefix+"/") {
			return true
		}
	}
	return false
}
