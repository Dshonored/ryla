# Development database for {{.Name}}.
#
# The credentials match the DSN in .env, and `ry dev` and `ry migrate` start
# this for you, so it is here to be read and edited rather than run by hand.
#
# This is for local development only. It has no password worth the name and
# publishes the port on your machine — do not point production at it.

services:
  postgres:
    image: postgres:17
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{.Name}}
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      # ry migrate fails with a connection refused if it runs before Postgres
      # finishes starting, which looks like a configuration problem rather than
      # a timing one. This is what lets `docker compose up --wait` be honest.
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{.Name}}"]
      interval: 5s
      timeout: 5s
      retries: 10

# ---------------------------------------------------------------------------
# The rest of the development stack, off until you want it.
#
# `ry dev` starts the database alone. Uncomment a service below and
# `ry dev full` starts it too: the "full" profile is what keeps it out of the
# plain dev loop, so enabling mailpit does not slow down every rebuild.
#
#   redis    what CACHE_DRIVER, SESSION_DRIVER and QUEUE_DRIVER=redis talk to.
#            .env already points at localhost:6379, so setting those three is
#            the whole of it.
#   mailpit  an SMTP server that captures mail rather than delivering it, with
#            a web inbox on http://localhost:8025. .env already points at port
#            1025, so set MAIL_DRIVER=smtp and MAIL_ENCRYPTION=none.
#
# Neither keeps a volume. A development cache and a development inbox are both
# meant to be thrown away, and one that survives a restart is a confusing bug
# rather than a feature.
#
# Uncomment from here down.
#
#  redis:
#    image: redis:7-alpine
#    profiles: ["full"]
#    restart: unless-stopped
#    ports:
#      - "6379:6379"
#    healthcheck:
#      test: ["CMD", "redis-cli", "ping"]
#      interval: 5s
#      timeout: 5s
#      retries: 10
