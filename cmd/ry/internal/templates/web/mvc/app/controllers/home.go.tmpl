package controllers

import (
	"net/http"
	"runtime"
	"strings"

	"github.com/Dshonored/ryla"

	"{{.Module}}/app"
	"{{.Module}}/resources/views"
)

// Home serves the landing page.
type Home struct {
	Base
}

// NewHome builds the controller. Dependencies arrive through the App struct
// rather than being resolved from a container, so this wiring is visible in
// routes/web.go and checked by the compiler.
func NewHome(a *app.App) *Home {
	return &Home{Base{App: a}}
}

// Index handles GET /.
func (c *Home) Index(w http.ResponseWriter, r *http.Request) {
	c.Render(w, r, views.Home(pageEnv(c.App, w, r), views.SubscribeForm{}))
}

// pageEnv gathers what the welcome page reports about the running application.
// Both controllers that render the page need it. Delete it with the demo.
func pageEnv(a *app.App, w http.ResponseWriter, r *http.Request) views.Env {
	return views.Env{
		AppName:  a.Config.Name,
		RylaVer:  ryla.Version(),
		GoVer:    strings.TrimPrefix(runtime.Version(), "go"),
		Env:      a.Config.Env,
		Database: a.Config.DB.Driver,
		Routes:   len(a.Router.Routes()),
		// Pull rather than peek: reading the messages is what clears them, so a
		// refresh does not show the same banner twice.
		Flashes: a.Flash.Pull(w, r),
	}
}
