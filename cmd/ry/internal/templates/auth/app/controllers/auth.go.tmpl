package controllers

import (
	"errors"
	"fmt"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"time"

	"gorm.io/gorm"

	ryauth "{{.RylaModule}}/auth"
	"{{.RylaModule}}/flash"
	"{{.RylaModule}}/mail"
	"{{.RylaModule}}/ratelimit"
	"{{.RylaModule}}/session"
	"{{.RylaModule}}/validate"

	"{{.Module}}/app"
	"{{.Module}}/app/mails"
	"{{.Module}}/app/models"
	"{{.Module}}/app/requests"
	"{{.Module}}/resources/views/auth"
)

// Auth handles registration, sign-in, sign-out and password resets.
type Auth struct {
	Base

	// attempts throttles failed sign-ins per email address.
	//
	// The route-level limiter counts requests per IP; this counts failures per
	// account, which is what stops one address being attacked from many
	// machines. Only failures are counted, and a success clears the record, so
	// this is invisible to anyone typing their own password.
	attempts *ratelimit.Limiter
}

// NewAuth builds the controller.
func NewAuth(a *app.App) *Auth {
	return &Auth{
		Base:     Base{App: a},
		attempts: ratelimit.New(5, 15*time.Minute),
	}
}

// ShowRegister handles GET /register.
func (c *Auth) ShowRegister(w http.ResponseWriter, r *http.Request) {
	c.Render(w, r, auth.Register(auth.RegisterForm{}))
}

// Register handles POST /register.
//
// The response is the same whether or not the address is already registered:
// "check your inbox", every time. Saying "that email is already registered"
// would hand anyone a way to discover which addresses have accounts — exactly
// what the sign-in form refuses to reveal, given away by the form next to it.
//
// The person who owns the address still finds out what happened, because the
// difference goes into the email rather than the page.
func (c *Auth) Register(w http.ResponseWriter, r *http.Request) {
	var form requests.Register

	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}
	form.Email = normalizeEmail(form.Email)

	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.Register(auth.RegisterForm{
			Name: form.Name, Email: form.Email, Errors: bag,
		}))
		return
	}

	var existing models.User
	err = c.App.DB.Where("email = ?", form.Email).First(&existing).Error

	switch {
	case err == nil:
		// Already registered. Tell the owner of the address, not the browser.
		c.sendAccountExists(r, existing)

	case errors.Is(err, gorm.ErrRecordNotFound):
		if err := c.createUnverified(r, form); err != nil {
			c.serverError(w, r, "create user", err)
			return
		}

	default:
		c.serverError(w, r, "look up user", err)
		return
	}

	c.App.Flash.Add(w, r, flash.Info,
		"Check your inbox — we have sent a link to "+form.Email+".")
	c.Redirect(w, r, "/login")
}

// createUnverified stores the account and emails a confirmation link.
//
// The user is deliberately not signed in yet: doing so would make a successful
// signup observably different from one that hit an existing address, which is
// the leak this flow exists to close.
func (c *Auth) createUnverified(r *http.Request, form requests.Register) error {
	hash, err := ryauth.Hash(form.Password)
	if err != nil {
		return err
	}

	user := models.User{Name: form.Name, Email: form.Email, Password: hash}
	if err := c.App.DB.Create(&user).Error; err != nil {
		// Two simultaneous signups can both pass the check above; the unique
		// index settles it. The loser is treated as an existing account, which
		// is the truth by then.
		if errors.Is(err, gorm.ErrDuplicatedKey) {
			c.sendAccountExists(r, user)
			return nil
		}
		return err
	}

	token := c.App.Signer.Sign(ryauth.PurposeVerifyEmail, strconv.FormatUint(uint64(user.ID), 10), 24*time.Hour)
	link := c.App.Config.URL + "/verify?token=" + url.QueryEscape(token)

	msg := mails.VerifyEmail(c.App.From(), mail.Address{Name: user.Name, Email: user.Email},
		c.App.Config.Name, link)

	if err := c.App.Mail.Send(r.Context(), msg); err != nil {
		// The account exists; the email did not go out. Logging beats failing
		// the signup — the address can be confirmed again later.
		c.App.Log.Error("could not send the verification email", "error", err, "user", user.ID)
	}
	return nil
}

func (c *Auth) sendAccountExists(r *http.Request, user models.User) {
	msg := mails.AccountExists(c.App.From(), mail.Address{Name: user.Name, Email: user.Email},
		c.App.Config.Name, c.App.Config.URL+"/login")

	if err := c.App.Mail.Send(r.Context(), msg); err != nil {
		c.App.Log.Error("could not send the account-exists email", "error", err)
	}
}

// Verify handles GET /verify.
func (c *Auth) Verify(w http.ResponseWriter, r *http.Request) {
	subject, err := c.App.Signer.Verify(ryauth.PurposeVerifyEmail, r.URL.Query().Get("token"))
	if err != nil {
		c.App.Flash.Add(w, r, flash.Error,
			"That confirmation link is invalid or has expired. Sign up again to get a new one.")
		c.Redirect(w, r, "/register")
		return
	}

	id, err := strconv.ParseUint(subject, 10, 64)
	if err != nil {
		c.App.Flash.Add(w, r, flash.Error, "That confirmation link is not valid.")
		c.Redirect(w, r, "/register")
		return
	}

	var user models.User
	if err := c.App.DB.First(&user, uint(id)).Error; err != nil {
		c.App.Flash.Add(w, r, flash.Error, "That account no longer exists.")
		c.Redirect(w, r, "/register")
		return
	}

	if !user.Verified() {
		now := time.Now()
		if err := c.App.DB.Model(&user).Update("email_verified_at", now).Error; err != nil {
			c.serverError(w, r, "mark the address verified", err)
			return
		}
	}

	// Confirming the link proves control of the address, so this is a fine
	// moment to sign them in.
	ryauth.LoginID(session.From(r.Context()), user.ID)
	c.App.Flash.Add(w, r, flash.Success, "Welcome, "+user.Name+".")
	c.Redirect(w, r, "/")
}

// ShowLogin handles GET /login.
func (c *Auth) ShowLogin(w http.ResponseWriter, r *http.Request) {
	// Pulled here so the "check your inbox" message set by Register survives
	// its redirect and is shown exactly once.
	c.Render(w, r, auth.Login(auth.LoginForm{Messages: c.App.Flash.Pull(w, r)}))
}

// Login handles POST /login.
func (c *Auth) Login(w http.ResponseWriter, r *http.Request) {
	var form requests.Login

	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}
	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.Login(auth.LoginForm{
			Email: form.Email, Errors: bag,
		}))
		return
	}

	form.Email = normalizeEmail(form.Email)

	if ok, retryAfter := c.attempts.Allow(form.Email); !ok {
		c.App.Log.Warn("sign-in throttled", "email", form.Email, "retry_after", retryAfter)
		w.Header().Set("Retry-After", strconv.Itoa(int(retryAfter.Seconds())+1))

		bag := validate.ErrorBag{}
		bag.Add("email", "Too many sign-in attempts. Try again in a few minutes.")
		c.RenderStatus(w, r, http.StatusTooManyRequests, auth.Login(auth.LoginForm{
			Email: form.Email, Errors: bag,
		}))
		return
	}

	var user models.User
	err = c.App.DB.Where("email = ?", form.Email).First(&user).Error

	switch {
	case errors.Is(err, gorm.ErrRecordNotFound):
		// Hash anyway. Without this, a missing account answers noticeably
		// faster than a wrong password, and that difference tells an attacker
		// which addresses are registered.
		ryauth.DummyVerify(form.Password)
		c.failLogin(w, r, form.Email)
		return
	case err != nil:
		c.serverError(w, r, "look up user", err)
		return
	}

	ok, err := ryauth.Verify(user.Password, form.Password)
	if err != nil {
		c.serverError(w, r, "verify password", err)
		return
	}
	if !ok {
		c.failLogin(w, r, form.Email)
		return
	}

	// The one moment the plaintext password is in hand, so the only moment an
	// outdated hash can be upgraded without asking the user to do anything.
	if ryauth.NeedsRehash(user.Password) {
		if hash, err := ryauth.Hash(form.Password); err == nil {
			c.App.DB.Model(&user).Update("password", hash)
		}
	}

	// A correct password clears the record, so someone who mistyped twice and
	// then got it right is not left near the limit.
	c.attempts.Reset(form.Email)

	s := session.From(r.Context())
	ryauth.LoginID(s, user.ID)
	c.App.Flash.Add(w, r, flash.Success, "Signed in.")

	// Back to whatever they were trying to reach before being sent here.
	c.Redirect(w, r, ryauth.Intended(s, "/"))
}

// Logout handles POST /logout.
func (c *Auth) Logout(w http.ResponseWriter, r *http.Request) {
	s := session.From(r.Context())

	// Remove the server-side row as well as clearing the session, so the old
	// id cannot be replayed by anything still holding the cookie.
	if store, ok := c.App.Session.(*session.DBStore); ok {
		_ = store.Destroy(w, r, s)
	}
	ryauth.Logout(s)

	c.App.Flash.Add(w, r, flash.Info, "Signed out.")
	c.Redirect(w, r, "/")
}

// failLogin reports a bad email or password without saying which.
//
// Naming the wrong one turns the login form into a tool for discovering
// registered addresses.
func (c *Auth) failLogin(w http.ResponseWriter, r *http.Request, email string) {
	bag := validate.ErrorBag{}
	bag.Add("email", "Those credentials do not match our records.")

	c.App.Log.Info("failed sign-in attempt", "email", email)
	c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.Login(auth.LoginForm{
		Email: email, Errors: bag,
	}))
}

func (c *Auth) serverError(w http.ResponseWriter, r *http.Request, what string, err error) {
	c.App.Log.Error("could not "+what, "error", err, "path", r.URL.Path)
	http.Error(w, "Something went wrong.", http.StatusInternalServerError)
}

// normalizeEmail lowercases and trims, so Alice@Example.com and
// alice@example.com cannot become two accounts.
func normalizeEmail(email string) string {
	return strings.ToLower(strings.TrimSpace(email))
}

// resetWindow is how long an emailed reset link stays usable.
//
// Short, because the link is a bearer credential sitting in a mailbox: anyone
// holding it can take the account over. Long enough that somebody who reads
// their email on another device still gets there in time.
//
// Nothing is stored server-side to mark a token spent, so a link keeps working
// for the rest of the hour even after it has been used. Keeping the window
// tight is what limits that; storing issued tokens is the alternative, and it
// costs a table.
const resetWindow = time.Hour

// ShowForgotPassword handles GET /forgot-password.
func (c *Auth) ShowForgotPassword(w http.ResponseWriter, r *http.Request) {
	// Pulled here so the "that link has expired" message set by the reset
	// handlers survives its redirect and is shown exactly once.
	c.Render(w, r, auth.ForgotPassword(auth.ForgotPasswordForm{Messages: c.App.Flash.Pull(w, r)}))
}

// ForgotPassword handles POST /forgot-password.
//
// Like Register, the response is the same whether or not the address has an
// account: "check your inbox", every time. Answering "no account with that
// address" would turn this form into the account-discovery tool the sign-in
// form deliberately refuses to be — and it sits one page away from that form,
// so the leak would be just as useful.
//
// Both branches send an email, so the sentence on the page is true either way;
// the difference goes into the message rather than the response.
func (c *Auth) ForgotPassword(w http.ResponseWriter, r *http.Request) {
	var form requests.ForgotPassword

	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}
	form.Email = normalizeEmail(form.Email)

	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.ForgotPassword(auth.ForgotPasswordForm{
			Email: form.Email, Errors: bag,
		}))
		return
	}

	var user models.User
	err = c.App.DB.Where("email = ?", form.Email).First(&user).Error

	switch {
	case err == nil:
		c.sendResetLink(r, user)

	case errors.Is(err, gorm.ErrRecordNotFound):
		c.sendResetNoAccount(r, form.Email)

	default:
		c.serverError(w, r, "look up user", err)
		return
	}

	c.App.Flash.Add(w, r, flash.Info,
		"Check your inbox — we have sent a link to "+form.Email+".")
	c.Redirect(w, r, "/login")
}

// sendResetLink emails the signed link for a real account.
func (c *Auth) sendResetLink(r *http.Request, user models.User) {
	// PurposeResetPassword, so this token cannot be handed to /verify to
	// confirm an address, and a confirmation link cannot be handed here to
	// change a password.
	token := c.App.Signer.Sign(ryauth.PurposeResetPassword, strconv.FormatUint(uint64(user.ID), 10), resetWindow)
	link := c.App.Config.URL + "/reset-password?token=" + url.QueryEscape(token)

	msg := mails.ResetPassword(c.App.From(), mail.Address{Name: user.Name, Email: user.Email},
		c.App.Config.Name, link)

	if err := c.App.Mail.Send(r.Context(), msg); err != nil {
		// Logged rather than surfaced: telling the browser the send failed
		// would answer differently for an address that has an account, which
		// is the whole point of this handler answering identically.
		c.App.Log.Error("could not send the password reset email", "error", err, "user", user.ID)
	}
}

// sendResetNoAccount tells the owner of an unregistered address what happened.
func (c *Auth) sendResetNoAccount(r *http.Request, email string) {
	msg := mails.PasswordResetNoAccount(c.App.From(), mail.Address{Email: email},
		c.App.Config.Name, c.App.Config.URL+"/register")

	if err := c.App.Mail.Send(r.Context(), msg); err != nil {
		c.App.Log.Error("could not send the no-account password reset email", "error", err)
	}
}

// ShowResetPassword handles GET /reset-password.
//
// The token is checked before the form is drawn, so a stale link says so
// straight away rather than after somebody has chosen and typed a new password
// twice.
func (c *Auth) ShowResetPassword(w http.ResponseWriter, r *http.Request) {
	token := r.URL.Query().Get("token")
	if _, err := c.App.Signer.Verify(ryauth.PurposeResetPassword, token); err != nil {
		c.expiredResetLink(w, r)
		return
	}

	c.Render(w, r, auth.ResetPassword(auth.ResetPasswordForm{Token: token}))
}

// ResetPassword handles POST /reset-password.
func (c *Auth) ResetPassword(w http.ResponseWriter, r *http.Request) {
	var form requests.ResetPassword

	bag, err := validate.BindAndCheck(r, &form)
	if err != nil {
		http.Error(w, "Could not read the submitted form.", http.StatusBadRequest)
		return
	}
	if bag.Any() {
		c.RenderStatus(w, r, http.StatusUnprocessableEntity, auth.ResetPassword(auth.ResetPasswordForm{
			Token: form.Token, Errors: bag,
		}))
		return
	}

	// Re-checked on submit, never trusted from the hidden field alone: the
	// signature is what proves the person at this form was sent the email, and
	// the expiry has to be judged now rather than when the page was drawn.
	subject, err := c.App.Signer.Verify(ryauth.PurposeResetPassword, form.Token)
	if err != nil {
		c.expiredResetLink(w, r)
		return
	}

	id, err := strconv.ParseUint(subject, 10, 64)
	if err != nil {
		c.expiredResetLink(w, r)
		return
	}

	var user models.User
	if err := c.App.DB.First(&user, uint(id)).Error; err != nil {
		c.expiredResetLink(w, r)
		return
	}

	hash, err := ryauth.Hash(form.Password)
	if err != nil {
		c.serverError(w, r, "hash the new password", err)
		return
	}

	fields := map[string]any{"password": hash}
	if !user.Verified() {
		// Opening the emailed link proves control of the address, which is the
		// same evidence /verify accepts. Leaving it unconfirmed afterwards
		// would be a state nothing else can clear.
		fields["email_verified_at"] = time.Now()
	}
	if err := c.App.DB.Model(&user).Updates(fields).Error; err != nil {
		c.serverError(w, r, "store the new password", err)
		return
	}

	c.signOutEverywhere(user)

	c.App.Flash.Add(w, r, flash.Success, "Your password has been changed. Sign in with it.")
	c.Redirect(w, r, "/login")
}

// signOutEverywhere ends every session belonging to the user.
//
// A reset is usually the answer to a compromise, so an attacker still holding a
// live session would keep exactly the access the reset was meant to take away —
// and could simply set the password again. Only a server-side store keeps the
// records this needs; a cookie store has nothing to revoke, so say so in the log
// rather than let an operator believe the sessions were ended.
func (c *Auth) signOutEverywhere(user models.User) {
	store, ok := c.App.Session.(*session.DBStore)
	if !ok {
		c.App.Log.Warn("password reset could not end the user's other sessions: this session store keeps no server-side record to revoke",
			"user", user.ID, "store", fmt.Sprintf("%T", c.App.Session))
		return
	}

	if err := store.DestroyForUser(strconv.FormatUint(uint64(user.ID), 10)); err != nil {
		// The password is already changed, so failing the request now would be
		// misleading. The sessions that survive are the cost, and the log is
		// what makes that visible.
		c.App.Log.Error("could not end the user's other sessions after a password reset", "error", err, "user", user.ID)
	}
}

// expiredResetLink sends the visitor back to ask for a fresh link.
//
// One message for expired, forged and pointing-at-a-deleted-account alike:
// separating them would let anyone with a token generator learn which user ids
// exist.
func (c *Auth) expiredResetLink(w http.ResponseWriter, r *http.Request) {
	c.App.Flash.Add(w, r, flash.Error,
		"That reset link is invalid or has expired. Ask for a new one.")
	c.Redirect(w, r, "/forgot-password")
}
