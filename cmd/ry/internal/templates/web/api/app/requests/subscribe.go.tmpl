package requests

// Subscribe is the demo endpoint's body. Delete it with the rest of the demo.
//
// The `json` tags name the fields, and the same names key the ErrorBag, so a
// client reads the message for a field under the name it sent. Unknown fields
// are rejected rather than ignored: a caller who misspells one should be told,
// not left wondering why the value never took effect.
type Subscribe struct {
	Name  string `json:"name" validate:"required,min=2,max=80"`
	Email string `json:"email" validate:"required,email"`
}
