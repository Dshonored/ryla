package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title }</title>
			// An inline SVG icon rather than a /favicon.ico file. Browsers
			// request that path unprompted, and a 404 on every page load is
			// noise in the log that says nothing about the application.
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232f6feb'/%3E%3Ctext x='16' y='23' font-family='system-ui,sans-serif' font-size='19' font-weight='700' fill='white' text-anchor='middle'%3ER%3C/text%3E%3C/svg%3E"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}
