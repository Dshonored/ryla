import { mount } from "svelte";

import App from "./App.svelte";
import "./app.css";

// index.html is the only place this element is declared, and TypeScript cannot
// see into it — getElementById is typed as possibly null and it is right to be.
// The check is here rather than a `!` so that a renamed div fails with a
// sentence instead of a null reference.
const target = document.getElementById("app");
if (!target) {
	throw new Error("No #app element — index.html and this file disagree.");
}

// The stylesheet is imported rather than linked from index.html so that Vite
// owns it: in development a change to it is swapped into the running page, and
// in a build it becomes a hashed file the browser can cache forever.
export default mount(App, { target });
