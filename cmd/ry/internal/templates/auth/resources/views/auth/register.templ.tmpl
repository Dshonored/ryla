package auth

import (
	"github.com/Dshonored/ryla/csrf"
	"github.com/Dshonored/ryla/validate"

	"{{.Module}}/resources/views"
)

// RegisterForm carries the sign-up form back after a failed attempt, so the
// user does not have to retype everything.
type RegisterForm struct {
	Name   string
	Email  string
	Errors validate.ErrorBag
}

templ Register(form RegisterForm) {
	@views.Layout("Create an account") {
		<div class="stack auth-card">
			<header class="stack-sm">
				<h1>Create an account</h1>
				<p class="muted small">
					Already registered? <a href="/login">Sign in</a>.
				</p>
			</header>

			<form method="post" action="/register" class="stack-sm" novalidate>
				@templ.Raw(csrf.Field(ctx))

				<div class="field">
					<label for="name">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						autocomplete="name"
						value={ form.Name }
						aria-invalid={ views.AriaInvalid(form.Errors, "name") }
					/>
					if form.Errors.Has("name") {
						<p class="field-error">{ form.Errors.First("name") }</p>
					}
				</div>

				<div class="field">
					<label for="email">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="username"
						value={ form.Email }
						aria-invalid={ views.AriaInvalid(form.Errors, "email") }
					/>
					if form.Errors.Has("email") {
						<p class="field-error">{ form.Errors.First("email") }</p>
					}
				</div>

				<div class="field">
					<label for="password">Password</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="new-password"
						aria-invalid={ views.AriaInvalid(form.Errors, "password") }
					/>
					if form.Errors.Has("password") {
						<p class="field-error">{ form.Errors.First("password") }</p>
					} else {
						<p class="muted small">At least 8 characters.</p>
					}
				</div>

				<div class="field">
					<label for="password_confirmation">Confirm password</label>
					<input
						id="password_confirmation"
						name="password_confirmation"
						type="password"
						autocomplete="new-password"
						aria-invalid={ views.AriaInvalid(form.Errors, "password_confirmation") }
					/>
					if form.Errors.Has("password_confirmation") {
						<p class="field-error">{ form.Errors.First("password_confirmation") }</p>
					}
				</div>

				<div>
					<button class="btn" type="submit">Create account</button>
				</div>
			</form>
		</div>
	}
}
