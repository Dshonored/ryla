package mails

import (
	"fmt"

	"{{.RylaModule}}/mail"
)

// VerifyEmail is sent to someone who has just signed up.
func VerifyEmail(from mail.Address, to mail.Address, appName, link string) mail.Message {
	return mail.Message{
		From:    from,
		To:      []mail.Address{to},
		Subject: "Confirm your email address",
		Text: fmt.Sprintf(`Welcome to %s.

Confirm your email address by opening this link:

%s

The link is valid for 24 hours. If you did not sign up, you can ignore this
message and no account will be created.
`, appName, link),
		HTML: fmt.Sprintf(`<p>Welcome to %s.</p>
<p><a href="%s">Confirm your email address</a></p>
<p>The link is valid for 24 hours. If you did not sign up, you can ignore this
message and no account will be created.</p>
`, appName, link),
	}
}

// AccountExists is sent when someone tries to sign up with an address that is
// already registered.
//
// This is what lets the sign-up form answer identically whether or not the
// address exists. Without it the form has to say "already registered", and
// anyone can use it to discover who has an account. The person who owns the
// address gets a useful message; whoever submitted the form learns nothing.
func AccountExists(from mail.Address, to mail.Address, appName, loginURL string) mail.Message {
	return mail.Message{
		From:    from,
		To:      []mail.Address{to},
		Subject: "You already have an account",
		Text: fmt.Sprintf(`Somebody tried to create a %s account with this email
address, but one already exists.

If it was you, sign in instead: %s

If it was not, you can ignore this message. Nothing has changed and no new
account was created.
`, appName, loginURL),
		HTML: fmt.Sprintf(`<p>Somebody tried to create a %s account with this email
address, but one already exists.</p>
<p>If it was you, <a href="%s">sign in instead</a>.</p>
<p>If it was not, you can ignore this message. Nothing has changed and no new
account was created.</p>
`, appName, loginURL),
	}
}

// ResetPassword carries the link that lets someone choose a new password.
func ResetPassword(from mail.Address, to mail.Address, appName, link string) mail.Message {
	return mail.Message{
		From:    from,
		To:      []mail.Address{to},
		Subject: "Reset your password",
		Text: fmt.Sprintf(`Somebody asked to reset the password on your %s account.

Choose a new one here:

%s

The link is valid for one hour. If you did not ask for this, you can ignore
this message — your password has not changed.
`, appName, link),
		HTML: fmt.Sprintf(`<p>Somebody asked to reset the password on your %s account.</p>
<p><a href="%s">Choose a new password</a></p>
<p>The link is valid for one hour. If you did not ask for this, you can ignore
this message — your password has not changed.</p>
`, appName, link),
	}
}

// PasswordResetNoAccount is sent when a reset is requested for an address that
// has no account.
//
// It is the counterpart of AccountExists, and it exists for the same reason:
// the forgot-password form has to answer identically either way, so the
// difference goes into the email instead of the page. Whoever submitted the
// form learns nothing; the owner of the address learns that no account of
// theirs is involved, which is usually the sign they signed up under a
// different address.
func PasswordResetNoAccount(from mail.Address, to mail.Address, appName, registerURL string) mail.Message {
	return mail.Message{
		From:    from,
		To:      []mail.Address{to},
		Subject: "Password reset requested",
		Text: fmt.Sprintf(`Somebody asked to reset the password for a %s account with
this email address, but no account uses it.

If that was you, you may have signed up with a different address. You can also
create an account here: %s

If it was not, you can ignore this message. Nothing has changed.
`, appName, registerURL),
		HTML: fmt.Sprintf(`<p>Somebody asked to reset the password for a %s account with
this email address, but no account uses it.</p>
<p>If that was you, you may have signed up with a different address. You can
also <a href="%s">create an account</a>.</p>
<p>If it was not, you can ignore this message. Nothing has changed.</p>
`, appName, registerURL),
	}
}
