// Package tests holds the application's feature tests.
//
// A feature test drives the application the way a browser does: the request
// goes through the real router and the whole middleware stack — sessions, CSRF,
// logging, recovery — rather than calling a handler function directly. That is
// what makes one worth writing. A handler called in isolation cannot tell you
// that its route is registered, that the middleware order is right, or that the
// form it renders is accepted by the CSRF check.
//
// Run them with `go test ./...`.
package tests

import (
	"net/http"
	"sync"
	"testing"

	"{{.RylaModule}}/csrf"
	"{{.RylaModule}}/session"
	rytest "{{.RylaModule}}/testing"

	"{{.Module}}/app"
	"{{.Module}}/routes"
)

var (
	buildOnce sync.Once
	built     *app.App
)

// application builds the whole application against a throwaway in-memory
// database with the migrations applied.
//
// Once for the test binary, not once per test: jobs and named routes register
// themselves into process-wide registries that refuse a duplicate, so a second
// app.New in the same process panics rather than quietly costing time. The
// trade is that tests share one database — clean up anything you write, or read
// it back through a fresh client rather than assuming an empty table.
func application(t *testing.T) *app.App {
	t.Helper()

	buildOnce.Do(func() {
		// Points DB_* at the throwaway database and fills in the rest of a
		// configuration that is safe to test against: a published signing key,
		// mail that is logged rather than sent, and no queue worker needed.
		// Real environment variables beat .env, so this wins over the file.
		rytest.Env(t)

		a, err := app.New()
		if err != nil {
			t.Fatalf("build the application: %v", err)
		}
		rytest.Migrate(t, a.DB)

		// The same call cmd/app makes. Without it the router has no routes and
		// every request below would answer 404.
		routes.Register(a)

		built = a
	})

	if built == nil {
		t.Fatal("the application could not be built; see the failure above")
	}
	return built
}

// client returns a browser-like client with its own cookie jar, so a test can
// never arrive already signed in because a different one logged in.
//
// It carries the application's CSRF token on every unsafe request, so a POST to
// a real form route works without hand-building one. To start from a signed-in
// user — which most tests worth writing do — call client(t).LoginID(user.ID).
func client(t *testing.T) *rytest.Client {
	t.Helper()

	a := application(t)
	return rytest.New(t, rytest.Config{
		Handler: a.Router,
		Jar:     a.Cookies,
		Session: a.Session,
	})
}

// TestTheHomePageRenders is the smallest end-to-end proof there is: the
// application boots, the route is registered, and the view compiles and renders.
func TestTheHomePageRenders(t *testing.T) {
	a := application(t)

	client(t).Get("/").
		AssertOK().
		AssertContains(a.Config.Name)
}

// TestTheHealthEndpointReportsOK covers the route a load balancer polls. It is
// the one endpoint whose contract belongs to something outside this codebase,
// so a change to its shape should break a test rather than a deployment.
func TestTheHealthEndpointReportsOK(t *testing.T) {
	var body struct {
		Status string `json:"status"`
	}

	client(t).Get("/up").
		AssertOK().
		AssertHeader("Content-Type", "application/json").
		AssertJSON(&body)

	if body.Status != "ok" {
		t.Errorf("status = %q, want ok", body.Status)
	}
}

// TestCSRFProtectsCookieAuthenticatedRequests pins the rule the middleware in
// app.go applies, because it is the kind of thing that is silently wrong: a
// weakened check breaks no build and fails no other test, and the first sign of
// it is somebody else's site acting on behalf of your signed-in users.
//
// What decides it is the credential, not the path. A request arriving with the
// session cookie is checked wherever it is addressed — /api included, which is
// where `ry make:auth` puts a signed-in session.
func TestCSRFProtectsCookieAuthenticatedRequests(t *testing.T) {
	// Signed in, because that is the state worth protecting — and because the
	// session store writes no cookie until a session holds something, so an
	// anonymous visitor has nothing to forge with and is not challenged.
	c := client(t).LoginID(1)

	if c.Cookie(session.CookieName) == nil {
		t.Fatal("no session cookie was issued, so this test would prove nothing")
	}

	// A token is set explicitly, and a wrong one on purpose: the test client
	// attaches the real token when the header is empty, which is the very
	// behaviour being checked here.
	req := c.Request(http.MethodPost, "/api/not-a-route", nil)
	req.Header.Set(csrf.HeaderName, "not-the-token")

	c.Do(req).AssertStatus(http.StatusForbidden)
}

// TestCSRFLeavesCredentiallessRequestsAlone is the other half of that rule, and
// the reason it is written in terms of the cookie rather than the path.
//
// A caller that sends no cookie has nothing another site could have caused to be
// attached, so there is no forgery to prevent and nothing to prove. Challenging
// it would break every API client that is not a browser — curl, a mobile app, a
// server-to-server call — for no gain.
func TestCSRFLeavesCredentiallessRequestsAlone(t *testing.T) {
	// A client that has made no request yet, so it holds no cookies.
	c := client(t)

	req := c.Request(http.MethodPost, "/api/not-a-route", nil)
	// Set so the client does not helpfully fetch a real token, which would
	// bring the CSRF cookie with it and make this a different test.
	req.Header.Set(csrf.HeaderName, "not-the-token")

	// The route does not exist; what matters is that it was not refused before
	// anything got the chance to say so.
	if got := c.Do(req).Status(); got == http.StatusForbidden {
		t.Errorf("a request with no cookies was challenged for CSRF (%d)", got)
	}
}
