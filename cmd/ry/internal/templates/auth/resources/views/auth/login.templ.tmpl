package auth

import (
	"github.com/Dshonored/ryla/csrf"
	"github.com/Dshonored/ryla/validate"

	"{{.Module}}/resources/views"
)

// LoginForm carries the sign-in form back after a failed attempt.
type LoginForm struct {
	Email  string
	Errors validate.ErrorBag
}

templ Login(form LoginForm) {
	@views.Layout("Sign in") {
		<div class="stack auth-card">
			<header class="stack-sm">
				<h1>Sign in</h1>
				<p class="muted small">
					No account? <a href="/register">Create one</a>.
				</p>
			</header>

			<form method="post" action="/login" class="stack-sm" novalidate>
				@templ.Raw(csrf.Field(ctx))

				<div class="field">
					<label for="email">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="username"
						value={ form.Email }
						aria-invalid={ views.AriaInvalid(form.Errors, "email") }
					/>
					if form.Errors.Has("email") {
						<p class="field-error">{ form.Errors.First("email") }</p>
					}
				</div>

				<div class="field">
					<label for="password">Password</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						aria-invalid={ views.AriaInvalid(form.Errors, "password") }
					/>
					if form.Errors.Has("password") {
						<p class="field-error">{ form.Errors.First("password") }</p>
					}
				</div>

				<div>
					<button class="btn" type="submit">Sign in</button>
				</div>
			</form>
		</div>
	}
}
