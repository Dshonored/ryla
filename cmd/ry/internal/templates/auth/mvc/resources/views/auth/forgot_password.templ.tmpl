package auth

import (
	"github.com/Dshonored/ryla/csrf"
	"github.com/Dshonored/ryla/flash"
	"github.com/Dshonored/ryla/validate"

	"{{.Module}}/resources/views"
)

// ForgotPasswordForm carries the "email me a link" form back after a failed
// attempt.
type ForgotPasswordForm struct {
	Email    string
	Errors   validate.ErrorBag
	Messages []flash.Message
}

templ ForgotPassword(form ForgotPasswordForm) {
	@views.Layout("Reset your password") {
		<div class="stack auth-card">
			@views.Flashes(form.Messages)

			<header class="stack-sm">
				<h1>Reset your password</h1>
				<p class="muted small">
					We will email you a link. Remembered it? <a href="/login">Sign in</a>.
				</p>
			</header>

			<form method="post" action="/forgot-password" class="stack-sm" novalidate>
				@templ.Raw(csrf.Field(ctx))

				<div class="field">
					<label for="email">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="username"
						value={ form.Email }
						aria-invalid={ views.AriaInvalid(form.Errors, "email") }
					/>
					if form.Errors.Has("email") {
						<p class="field-error">{ form.Errors.First("email") }</p>
					}
				</div>

				<div>
					<button class="btn" type="submit">Email me a link</button>
				</div>
			</form>
		</div>
	}
}
