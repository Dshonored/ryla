package requests

// Register is the sign-up form.
type Register struct {
	Name     string `form:"name" validate:"required,min=2,max=80"`
	Email    string `form:"email" validate:"required,email,max=255"`
	Password string `form:"password" validate:"required,min=8,max=200"`
	// eqfield compares against another field on this struct, so a mistyped
	// confirmation is caught before anything touches the database.
	Confirm string `form:"password_confirmation" validate:"required,eqfield=Password"`
}

// Login is the sign-in form.
//
// The password has no length rule on purpose: telling someone their password is
// "too short" at the login screen reveals the rule to anyone guessing, and the
// value either matches the stored hash or it does not.
type Login struct {
	Email    string `form:"email" validate:"required,email"`
	Password string `form:"password" validate:"required"`
	Remember bool   `form:"remember"`
}
