package app

import (
	"context"
	"errors"
	"flag"
	"fmt"
	"os"
	"strconv"
	"strings"
	"text/tabwriter"
	"time"

	ryapp "{{.RylaModule}}/app"
	"{{.RylaModule}}/migrate"
	"{{.RylaModule}}/queue"

	"{{.Module}}/database/seeders"
)

// Commands is the command set of the built application binary. Because these
// live on the binary rather than in the `ry` CLI, production deployments need
// nothing installed beyond the binary itself.
func (a *App) Commands() ryapp.Commands {
	return ryapp.Commands{
		{Name: "serve", Usage: "Start the HTTP server", Run: a.serve},
		{Name: "migrate", Usage: "Run pending database migrations", Run: a.migrate},
		{Name: "migrate:rollback", Usage: "Roll back the last batch of migrations", Run: a.migrateRollback},
		{Name: "migrate:status", Usage: "Show the status of every migration", Run: a.migrateStatus},
		{Name: "migrate:refresh", Usage: "Roll everything back, then migrate again", Run: a.migrateRefresh},
		{Name: "db:seed", Usage: "Run the database seeders", Run: a.dbSeed},
		{Name: "routes", Usage: "List the application's named routes", Run: a.routes},
		{Name: "queue:work", Usage: "Run background jobs until interrupted", Run: a.queueWork},
		{Name: "queue:failed", Usage: "List jobs that exhausted their attempts", Run: a.queueFailed},
		{Name: "queue:retry", Usage: "Put a failed job back on its queue", Run: a.queueRetry},
	}
}

func (a *App) serve(ctx context.Context, args []string) error {
	fs := flag.NewFlagSet("serve", flag.ContinueOnError)
	addr := fs.String("addr", a.Config.Addr, "address to listen on")
	if err := fs.Parse(args); err != nil {
		return err
	}

	srv := &ryapp.Server{
		Addr:            *addr,
		Handler:         a.Router,
		Log:             a.Log,
		ShutdownTimeout: 15 * time.Second,
	}
	return srv.Run(ctx)
}

func (a *App) migrator() *migrate.Runner {
	return &migrate.Runner{DB: a.DB, Log: a.Log}
}

func (a *App) migrate(ctx context.Context, args []string) error {
	fs := flag.NewFlagSet("migrate", flag.ContinueOnError)
	steps := fs.Int("steps", 0, "how many pending migrations to run (0 runs all)")
	if err := fs.Parse(args); err != nil {
		return err
	}
	return a.migrator().Up(ctx, *steps)
}

func (a *App) migrateRollback(ctx context.Context, args []string) error {
	fs := flag.NewFlagSet("migrate:rollback", flag.ContinueOnError)
	batches := fs.Int("batches", 1, "how many batches to roll back")
	if err := fs.Parse(args); err != nil {
		return err
	}
	return a.migrator().Rollback(ctx, *batches)
}

func (a *App) migrateRefresh(ctx context.Context, args []string) error {
	return a.migrator().Refresh(ctx)
}

func (a *App) migrateStatus(ctx context.Context, args []string) error {
	statuses, err := a.migrator().Status(ctx)
	if err != nil {
		return err
	}
	if len(statuses) == 0 {
		fmt.Println("No migrations found.")
		return nil
	}

	tw := tabwriter.NewWriter(os.Stdout, 0, 0, 3, ' ', 0)
	fmt.Fprintln(tw, "STATUS\tBATCH\tMIGRATION")
	for _, s := range statuses {
		switch {
		case s.Missing:
			fmt.Fprintf(tw, "missing\t%d\t%s\n", s.Batch, s.ID)
		case s.Applied:
			fmt.Fprintf(tw, "applied\t%d\t%s\n", s.Batch, s.ID)
		default:
			fmt.Fprintf(tw, "pending\t-\t%s\n", s.ID)
		}
	}
	return tw.Flush()
}

func (a *App) dbSeed(ctx context.Context, args []string) error {
	return seeders.Run(ctx, a.DB)
}

func (a *App) routes(ctx context.Context, args []string) error {
	all := a.Router.Routes()
	if len(all) == 0 {
		fmt.Println("No named routes. Name a route with .Name(\"...\") to see it here.")
		return nil
	}

	tw := tabwriter.NewWriter(os.Stdout, 0, 0, 3, ' ', 0)
	fmt.Fprintln(tw, "METHOD\tPATTERN\tNAME")
	for _, rt := range all {
		fmt.Fprintf(tw, "%s\t%s\t%s\n", rt.Method, rt.Pattern, rt.Name)
	}
	return tw.Flush()
}

func (a *App) queueWork(ctx context.Context, args []string) error {
	fs := flag.NewFlagSet("queue:work", flag.ContinueOnError)
	name := fs.String("queue", queue.Default, "which queue to drain")
	concurrency := fs.Int("concurrency", 1, "how many jobs may run at once")
	poll := fs.Duration("poll", time.Second, "how long to wait when the queue is empty")
	if err := fs.Parse(args); err != nil {
		return err
	}

	w := &queue.Worker{
		Driver:       queue.NewDBDriver(a.DB),
		Log:          a.Log,
		Queue:        *name,
		Concurrency:  *concurrency,
		PollInterval: *poll,
	}
	// ctx is cancelled on Ctrl-C or SIGTERM. The worker then lets in-flight
	// jobs finish rather than killing work that may already have had an effect.
	return w.Run(ctx)
}

func (a *App) queueFailed(ctx context.Context, args []string) error {
	fs := flag.NewFlagSet("queue:failed", flag.ContinueOnError)
	limit := fs.Int("limit", 25, "how many to show")
	if err := fs.Parse(args); err != nil {
		return err
	}

	failed, err := queue.NewDBDriver(a.DB).Failed(ctx, *limit)
	if err != nil {
		return err
	}
	if len(failed) == 0 {
		fmt.Println("No failed jobs.")
		return nil
	}

	tw := tabwriter.NewWriter(os.Stdout, 0, 0, 3, ' ', 0)
	fmt.Fprintln(tw, "ID\tQUEUE\tJOB\tATTEMPTS\tFAILED AT\tERROR")
	for _, f := range failed {
		fmt.Fprintf(tw, "%d\t%s\t%s\t%d\t%s\t%s\n",
			f.ID, f.Queue, f.Name, f.Attempts,
			f.FailedAt.Format(time.RFC3339), firstLine(f.LastError))
	}
	return tw.Flush()
}

func (a *App) queueRetry(ctx context.Context, args []string) error {
	if len(args) == 0 {
		return errors.New("usage: queue:retry <id> [id...]")
	}

	driver := queue.NewDBDriver(a.DB)
	for _, raw := range args {
		id, err := strconv.ParseUint(raw, 10, 64)
		if err != nil {
			return fmt.Errorf("%q is not a job id", raw)
		}
		if err := driver.Retry(ctx, uint(id)); err != nil {
			return fmt.Errorf("retry %d: %w", id, err)
		}
		fmt.Printf("Job %d is back on its queue.\n", id)
	}
	return nil
}

// firstLine keeps a multi-line error, such as a panic with its stack, from
// wrecking the table.
func firstLine(s string) string {
	if i := strings.IndexByte(s, '\n'); i >= 0 {
		return s[:i]
	}
	return s
}
