# Development database for {{.Name}}.
#
# The connection string in .env matches this, so it works untouched:
#
#   docker compose up -d
#   ry migrate
#
# No authentication, and the port is published on your machine. Local
# development only.

services:
  mongo:
    image: mongo:7
    restart: unless-stopped
    ports:
      - "27017:27017"
    volumes:
      - mongo-data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.runCommand({ping:1})"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  mongo-data:
