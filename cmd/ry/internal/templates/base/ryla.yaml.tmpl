# Project manifest. `ry` reads this to know how to build and run the app, so it
# never has to guess from the directory layout.
name: {{.Name}}
module: {{.Module}}

# Database driver this project was generated for.
database: {{.DB}}

# Web mode: mvc | api | react | svelte
web: {{.Web}}

build:
  # Package built by `ry build` and `ry dev`.
  main: ./cmd/app
  # Output binary, minus any platform extension.
  output: {{.Name}}
  # When true, `ry` runs `go tool templ generate` before every build.
  templ: {{.UsesTempl}}
{{- if .UsesVite }}
  # When true, `ry dev` runs the Vite dev server alongside the app and `ry build`
  # compiles the frontend before the Go build embeds it. Turning this off leaves
  # the last build embedded, which is occasionally what you want in CI.
  vite: true
  # Directory holding package.json. Vite writes into its dist/, which is the
  # directory resources/embed.go compiles into the binary.
  frontend: resources/frontend
{{- end }}

dev:
  # Extra paths the file watcher ignores, on top of the defaults.
  ignore:
    - storage
    - node_modules
