package models

import "time"

// User is an account that can sign in.
type User struct {
	ID    uint   `gorm:"primaryKey" json:"id"`
	Name  string `gorm:"size:80;not null" json:"name"`
	Email string `gorm:"size:255;not null;uniqueIndex" json:"email"`

	// Password holds an argon2id hash, never a plaintext password. The json
	// tag hides it, so a User serialised into an API response cannot leak it.
	Password string `gorm:"size:255;not null" json:"-"`

	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// TableName pins the table name so GORM's pluralisation can never drift from
// what the migrations created.
func (User) TableName() string { return "users" }
