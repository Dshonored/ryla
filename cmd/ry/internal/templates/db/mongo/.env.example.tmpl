# Application
APP_NAME={{.Name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_ADDR=:8080

# Signs cookies: CSRF tokens, flash messages, sessions.
# Generate one with: ry key:generate
APP_KEY=

# MongoDB
# The connection string, and the form hosting providers hand out.
MONGO_URI={{.DefaultDSN}}
# Which database to use. Empty means the one named in MONGO_URI's path, so this
# only needs setting when the URI has none.
MONGO_DATABASE=
# Bounds every operation. Without one, a network partition becomes a request
# that never returns.
MONGO_TIMEOUT=10s
MONGO_MAX_POOL_SIZE={{.DBMaxOpenConns}}

# How long a session lasts without activity.
SESSION_LIFETIME=336h

# Redis is only connected to when one of the drivers below asks for it.
# REDIS_URL takes precedence over the individual settings, since that is the
# form hosting providers hand out.
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX={{.Name}}

# Where background jobs are kept: mongo | redis
QUEUE_DRIVER=mongo

# Where sessions are kept: mongo | redis | cookie
#   cookie keeps everything in the browser and cannot be revoked, so "log out
#   everywhere" stops working. Prefer mongo or redis once anything signs in.
SESSION_DRIVER=mongo

# Cache
# CACHE_DRIVER: mongo | memory | redis
#   memory is per-process; behind several instances each keeps its own copy,
#   so an invalidation on one is invisible to the rest.
CACHE_DRIVER=mongo
CACHE_TTL=1h

# Mail
# MAIL_DRIVER: log | smtp
#   log prints the message instead of sending it, and is the default outside
#   production so local work cannot email a real person by accident.
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_NAME={{.Name}}
MAIL_FROM_ADDRESS=hello@example.com
# Send through the job queue, so a slow mail server never delays a response.
# Requires a worker: ry queue:work -queue mail
MAIL_QUEUE=true

# Logging
# LOG_LEVEL:  debug | info | warn | error
# LOG_FORMAT: auto | console | text | json
#   auto is a compact colour console on a terminal, JSON when redirected.
LOG_LEVEL=info
LOG_FORMAT=auto
