package routes

import (
	"net/http"
	"time"

	ryauth "{{.RylaModule}}/auth"
	"{{.RylaModule}}/ratelimit"
	"{{.RylaModule}}/router"

	"{{.Module}}/app"
	"{{.Module}}/app/controllers"
	appmw "{{.Module}}/app/middleware"
)

// RegisterTwoFactor attaches the two-factor authentication routes.
//
// Call it from Register in web.go, after RegisterAuth. It is a separate
// function in its own file so that the generator never had to rewrite your
// route table.
func RegisterTwoFactor(a *app.App) {
	twofa := controllers.NewTwoFactor(a)

	// Applied to every route, including ones added later. A signed-in session
	// that has not cleared the challenge is held at it wherever it goes; see
	// the middleware for why this is not the sign-in handler's job.
	a.Router.Use(appmw.RequireTwoFactor(a.DB))

	a.Router.Group(func(r *router.Router) {
		// Signed in, but not necessarily past the challenge — that is the whole
		// point of these pages.
		r.Use(ryauth.RequireAuth("/login"))

		r.Get("/two-factor", twofa.ShowChallenge).Name("two-factor.challenge")
		r.Get("/two-factor/setup", twofa.ShowSetup).Name("two-factor.setup")
		r.Get("/two-factor/setup/qr.png", twofa.SetupQRCode).Name("two-factor.qr")

		// Only the submissions are throttled, and only by address.
		//
		// The real limit is per account and lives in the controller, because
		// that is what an attacker spreading guesses across many machines runs
		// into. This one is the cheaper outer wall: it stops a single host
		// spending everybody's budget, and it costs nothing to keep.
		//
		// Counting page views as well would lock somebody out of even seeing
		// the form — and because the throttled page never renders a CSRF token,
		// every later submission would fail with a 403 that looks nothing like
		// the real cause.
		//
		// trustProxy stays false. Behind a proxy that overwrites
		// X-Forwarded-For, set it to true; anywhere else, trusting the header
		// lets a caller change it every request and never be limited at all.
		r.Group(func(r *router.Router) {
			r.Use(ratelimit.Middleware(ratelimit.Config{
				Limiter: ratelimit.New(10, time.Minute),
				KeyFunc: func(req *http.Request) string {
					return ratelimit.ClientIP(req, false)
				},
			}))

			r.Post("/two-factor", twofa.Challenge).Name("two-factor.verify")
			r.Post("/two-factor/recovery", twofa.Recover).Name("two-factor.recover")

			r.Post("/two-factor/setup", twofa.Enable).Name("two-factor.enable")
			r.Post("/two-factor/disable", twofa.Disable).Name("two-factor.disable")
		})
	})
}
