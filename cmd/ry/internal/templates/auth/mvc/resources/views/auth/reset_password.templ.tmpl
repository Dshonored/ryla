package auth

import (
	"github.com/Dshonored/ryla/csrf"
	"github.com/Dshonored/ryla/validate"

	"{{.Module}}/resources/views"
)

// ResetPasswordForm carries the new-password form back after a failed attempt.
//
// Token is carried with it: the form is what proves the visitor was sent the
// email, so losing it on a mistyped confirmation would send them back to their
// inbox for no reason.
type ResetPasswordForm struct {
	Token  string
	Errors validate.ErrorBag
}

templ ResetPassword(form ResetPasswordForm) {
	@views.Layout("Choose a new password") {
		<div class="stack auth-card">
			<header class="stack-sm">
				<h1>Choose a new password</h1>
				<p class="muted small">
					Setting it will sign you out everywhere else.
				</p>
			</header>

			<form method="post" action="/reset-password" class="stack-sm" novalidate>
				@templ.Raw(csrf.Field(ctx))
				<input type="hidden" name="token" value={ form.Token }/>

				<div class="field">
					<label for="password">New password</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="new-password"
						aria-invalid={ views.AriaInvalid(form.Errors, "password") }
					/>
					if form.Errors.Has("password") {
						<p class="field-error">{ form.Errors.First("password") }</p>
					} else {
						<p class="muted small">At least 8 characters.</p>
					}
				</div>

				<div class="field">
					<label for="password_confirmation">Confirm password</label>
					<input
						id="password_confirmation"
						name="password_confirmation"
						type="password"
						autocomplete="new-password"
						aria-invalid={ views.AriaInvalid(form.Errors, "password_confirmation") }
					/>
					if form.Errors.Has("password_confirmation") {
						<p class="field-error">{ form.Errors.First("password_confirmation") }</p>
					}
				</div>

				<div>
					<button class="btn" type="submit">Set new password</button>
				</div>
			</form>
		</div>
	}
}
