# Application
APP_NAME={{.Name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_ADDR=:8080

# Signs cookies: CSRF tokens, flash messages, sessions.
# Generate one with: ry key:generate
APP_KEY=

# Database
DB_DRIVER={{.DB}}
DB_DSN={{.DefaultDSN}}
DB_LOG_QUERIES=false

# How long a session lasts without activity.
SESSION_LIFETIME=336h

# Redis is only connected to when one of the drivers below asks for it.
# REDIS_URL takes precedence over the individual settings, since that is the
# form hosting providers hand out.
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX={{.Name}}

# Where background jobs are kept: db | redis
QUEUE_DRIVER=db

# Where sessions are kept: db | redis | cookie
#   cookie keeps everything in the browser and cannot be revoked, so "log out
#   everywhere" stops working. Prefer db or redis once anything signs in.
SESSION_DRIVER=db

# Cache
# CACHE_DRIVER: memory | db | redis
#   memory is per-process; behind several instances each keeps its own copy.
CACHE_DRIVER=memory
CACHE_TTL=1h

# Mail
# MAIL_DRIVER: log | smtp
#   log prints the message instead of sending it, and is the default outside
#   production so local work cannot email a real person by accident.
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_NAME={{.Name}}
MAIL_FROM_ADDRESS=hello@example.com
# Send through the job queue, so a slow mail server never delays a response.
# Requires a worker: ry queue:work -queue mail
MAIL_QUEUE=true

# Logging
# LOG_LEVEL:  debug | info | warn | error
# LOG_FORMAT: auto | console | text | json
#   auto is a compact colour console on a terminal, JSON when redirected.
LOG_LEVEL=info
LOG_FORMAT=auto
