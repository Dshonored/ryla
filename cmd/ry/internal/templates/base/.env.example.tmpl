# Application
APP_NAME={{.Name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_ADDR=:8080

# Signs session cookies. Generate one with: ry key:generate
APP_KEY=

# Database
DB_DRIVER={{.DB}}
DB_DSN={{.DefaultDSN}}
DB_LOG_QUERIES=false

# Logging: debug | info | warn | error
LOG_LEVEL=info
LOG_JSON=false
